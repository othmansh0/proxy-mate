{
  "name": "@othmansh0/proxy-mcp",
  "version": "0.8.3",
  "description": "Give coding agents access to Simulator HTTP traffic, API mocks, breakpoints and durable QA evidence.",
  "type": "module",
  "bin": {
    "proxy-mcp": "src/server.mjs"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.d.ts",
    "scripts/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "keywords": [
    "mcp",
    "ios",
    "xcode",
    "simulator",
    "proxy",
    "http",
    "https",
    "debugging"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "doctor": "node src/server.mjs doctor",
    "verify:simulator": "node scripts/verify-simulator.mjs",
    "test:soak": "node scripts/soak-proxy.mjs",
    "analyze:capture": "node scripts/analyze-capture.mjs",
    "benchmark:storage": "node scripts/benchmark-session-store.mjs",
    "test": "node --test --test-reporter=spec",
    "check": "node --check src/server.mjs && node --check src/client.mjs && node --check src/guardian.mjs && node --test --test-reporter=spec",
    "prepublishOnly": "node scripts/check-private-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "mockttp": "^4.6.5",
    "proper-lockfile": "^4.1.2",
    "quickjs-emscripten": "0.32.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "overrides": {
    "@hono/node-server": "2.1.6",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "hono": "4.13.17",
    "ip-address": "10.7.6",
    "ws": "8.21.3",
    "qs": "6.17.1",
    "basic-ftp": "6.2.6"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/othmansh0/proxy-mcp.git"
  },
  "homepage": "https://github.com/othmansh0/proxy-mcp#readme",
  "bugs": {
    "url": "https://github.com/othmansh0/proxy-mcp/issues"
  },
  "bundleDependencies": [
    "@modelcontextprotocol/sdk",
    "mockttp",
    "proper-lockfile",
    "quickjs-emscripten",
    "zod",
    "better-sqlite3"
  ]
}
